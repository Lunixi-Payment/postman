              { "key": "Idempotency-Key", "value": "checkout:{{order_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{amount_minor}},\n  \"currency\": \"{{currency}}\",\n  \"orderId\": \"{{order_id}}\",\n  \"callbackUrl\": \"{{callback_url}}\",\n  \"description\": \"Postman checkout smoke test\",\n  \"metadata\": {\n    \"allowedOrigin\": \"http://localhost:8080\",\n    \"checkoutOrigin\": \"http://localhost:8080\"\n  },\n  \"buyer\": {\n    \"name\": \"Ada\",\n    \"surname\": \"Yilmaz\",\n    \"identityNumber\": \"11111111111\",\n    \"email\": \"ada@example.com\",\n    \"gsmNumber\": \"+905350000000\",\n    \"city\": \"Istanbul\",\n    \"country\": \"Turkey\",\n    \"zipCode\": \"34000\",\n    \"ip\": \"127.0.0.1\"\n  },\n  \"billingAddress\": {\n    \"address\": \"Example Street 1\",\n    \"zipCode\": \"34000\",\n    \"contactName\": \"Ada Yilmaz\",\n    \"city\": \"Istanbul\",\n    \"country\": \"Turkey\"\n  },\n  \"basketItems\": [\n    {\n      \"id\": \"SKU-001\",\n      \"price\": {{amount_minor}},\n      \"name\": \"Demo Product\",\n      \"category1\": \"Demo\",\n      \"itemType\": \"PHYSICAL\"\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/api/v1/payments/intents"
          }
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/payments/{{payment_id}}"
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/payments?limit=10&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "page", "value": "1" }
              ]
            }
          }
        }
      ]
    },
