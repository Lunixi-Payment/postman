{
  "info": {
    "_postman_id": "84c0f732-715c-4ed4-9b3b-dbd96a4dbe38",
    "name": "Lunixi Payment Gateway",
    "description": "Professional Postman collection for Lunixi payment integrations. Tokens are minted automatically through the local signer helper.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expiresAt = Number(pm.environment.get('access_token_expires_at') || 0);",
          "const currentToken = pm.environment.get('access_token');",
          "const skipAuth = pm.request.headers.get('X-Lunixi-Skip-Auto-Auth') === 'true';",
          "if (!skipAuth && (!currentToken || Date.now() >= expiresAt)) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('signer_url') + '/token',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "      mode: 'raw',",
          "      raw: JSON.stringify({",
          "        baseUrl: pm.environment.get('base_url'),",
          "        authTokenPath: pm.environment.get('auth_token_path') || '/api/v1/auth/token',",
          "        keyId: pm.environment.get('key_id')",
          "      })",
          "    }",
          "  }, function (err, res) {",
          "    if (err) { throw new Error('Token signer unavailable: ' + err.message); }",
          "    const json = res.json();",
          "    if (!res.code || res.code >= 400 || !json.accessToken) {",
          "      throw new Error('Token mint failed: ' + JSON.stringify(json));",
          "    }",
          "    pm.environment.set('access_token', json.accessToken);",
          "    pm.environment.set('access_token_expires_at', String(json.expiresAt));",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is not an unhandled server error', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "let body = {};",
          "try { body = pm.response.json(); } catch (e) { body = {}; }",
          "const data = body && typeof body.data === 'object' ? body.data : body;",
          "if (data.paymentId || data.id) pm.environment.set('payment_id', data.paymentId || data.id);",
          "if (data.token) pm.environment.set('checkout_token', data.token);",
          "if (data.storedCardToken || data.cardToken) pm.environment.set('stored_card_token', data.storedCardToken || data.cardToken);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signer Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "X-Lunixi-Skip-Auto-Auth", "value": "true" }
            ],
            "url": "{{signer_url}}/health"
          }
        },
        {
          "name": "Mint Merchant Token Via Signer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "X-Lunixi-Skip-Auto-Auth", "value": "true" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseUrl\": \"{{base_url}}\",\n  \"authTokenPath\": \"{{auth_token_path}}\",\n  \"keyId\": \"{{key_id}}\"\n}"
            },
            "url": "{{signer_url}}/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('token minted', function () { pm.expect(json.accessToken).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('access_token', json.accessToken);",
                  "pm.environment.set('access_token_expires_at', String(json.expiresAt));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payments / Checkout",
      "item": [
        {
          "name": "Create Checkout Intent",
          "request": {
            "method": "POST",
            "header": [
